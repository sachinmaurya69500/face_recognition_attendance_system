{
  "expo": {
    "name": "FaceAttend",
    "slug": "faceattend",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.faceattend.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "FaceAttend uses the camera for authorized face registration and attendance."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "c0660eff-2da5-4047-998f-4994149eee36"
      }
    }
  }
}
