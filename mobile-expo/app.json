    "icon": "./assets/pratyaksha-logo.jpg",
    "splash": {
      "image": "./assets/pratyaksha-logo.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#F8FBFC"
    },
    "android": {
      "package": "com.attendai.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-camera",
      "expo-image-picker"
    ],
    "extra": {
      "eas": {
        "projectId": "26ab6477-9cc1-4f60-b8e1-abcc1061f641"
      }
    },
    "owner": "sachinmaurya6950s-team"
  }
