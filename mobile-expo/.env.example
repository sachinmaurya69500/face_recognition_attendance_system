# Android emulator with a backend running natively on this computer.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# For a physical phone, replace the line above with your computer's LAN IP,
# for example: EXPO_PUBLIC_API_URL=http://192.168.1.25:8000
# For Docker through Nginx, use: EXPO_PUBLIC_API_URL=http://192.168.1.25:8080
