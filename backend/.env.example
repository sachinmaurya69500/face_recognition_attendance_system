# Docker Compose configuration. Copy to backend/.env before the first Docker run.
# Replace the passwords and AUTH_SECRET before any shared deployment.
POSTGRES_DB=attendance_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass

DB_HOST=db
DB_PORT=5432
DB_NAME=attendance_db
DB_USER=postgres
DB_PASSWORD=postgres_secure_pass

AUTH_SECRET=replace-with-a-long-random-secret
MATCH_THRESHOLD=0.65
MAX_IMAGE_BYTES=20971520
MAX_FACES=300
FACE_DET_THRESHOLD=0.35
FACE_DET_SIZE=640
INSIGHTFACE_MODEL=buffalo_l
INSIGHTFACE_ROOT=/workspace
INFERENCE_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider
REQUIRE_GPU=1
GUNICORN_WORKERS=1
GUNICORN_THREADS=1
GUNICORN_TIMEOUT=300
GUNICORN_GRACEFUL_TIMEOUT=30
# Comma-separated browser origins. Native Expo clients do not need CORS.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
